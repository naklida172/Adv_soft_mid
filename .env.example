# Настройки сервера
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Безопасность между сервисами
REQUIRE_API_KEY=false
SERVICE_API_KEYS=["service-key-alpha", "service-key-beta"]

# Провайдер кошелька: "mock", "web3_evm", "bitcoin_rpc"
WALLET_PROVIDER_TYPE=mock
MOCK_NETWORK_LATENCY_MS=30

# Web3 / EVM RPC узел (Geth, Nethermind, Anvil, Polygon, etc.)
WEB3_RPC_URL=http://localhost:8545

# Bitcoin Core / Electrum RPC
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASSWORD=rpcpassword

